{
  "name": "musical-local-server",
  "version": "1.0.0",
  "description": "Musical.run Local Server - Privacy-first code generation on your machine",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "jest",
    "test:unit": "jest __tests__/unit",
    "test:integration": "jest __tests__/integration",
    "test:e2e": "jest __tests__/e2e",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "generate-keys": "tsx src/scripts/generate-keys.ts"
  },
  "keywords": [
    "musical",
    "local-server",
    "privacy",
    "code-generation",
    "claude",
    "encryption"
  ],
  "author": "Musical.run Team",
  "license": "MIT",
  "dependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "axios": "^1.6.5",
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "dockerode": "^4.0.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "libsodium-wrappers": "^0.7.11",
    "morgan": "^1.10.0",
    "open": "^10.0.3",
    "pg": "^8.11.3",
    "prompts": "^2.4.2",
    "qrcode": "^1.5.3",
    "socket.io": "^4.6.1",
    "ssh2": "^1.15.0",
    "tar-stream": "^3.1.7",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/dockerode": "^3.3.44",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.19.19",
    "@types/pg": "^8.10.9",
    "@types/prompts": "^2.4.9",
    "@types/qrcode": "^1.5.5",
    "@types/ssh2": "^1.15.0",
    "@types/supertest": "^6.0.3",
    "@types/tar-stream": "^3.1.4",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
