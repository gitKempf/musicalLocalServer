# Musical.run Local Server Configuration

# Server
PORT=17100
NODE_ENV=development

# Encryption
ENCRYPTION_KEY_PATH=/root/.musical/keys/encryption.key

# Claude Code CLI Authentication
# Authentication is handled via 'claude setup-token' command
# The token is stored in ~/.config/claude-code/ and mounted to container
# No API key needed here!

# Local Database
DB_HOST=localhost
DB_PORT=17102
DB_NAME=musical_local
DB_USER=musical
DB_PASSWORD=change_this_password

# Musical.run Cloud Connection
CLOUD_API_URL=https://api.musical.run
CLOUD_REGISTRATION_ENABLED=true

# Authentication
# Auto-authenticate with Musical.run on startup
AUTO_AUTH_ENABLED=true
AUTH_SERVICE_URL=https://musical.run

# Tunnel Configuration
TUNNEL_ENABLED=true
TUNNEL_ROUTER_URL=https://musical.run
# USER_ID is automatically set from authenticated user (leave empty)

# Auto-shutdown
CLAUDE_AUTO_SHUTDOWN_MINUTES=30

# Logging
LOG_LEVEL=info
LOG_FILE=/root/.musical/logs/server.log

# Preview
PREVIEW_PORT=17103
PREVIEW_DOMAIN=preview.musical.run

# Gitea Integration (optional - for Git version control)
# To enable Git integration:
# 1. Start Gitea: docker-compose up -d local-gitea
# 2. Create a user in Gitea and generate an API token
# 3. Set these environment variables
GITEA_URL=http://local-gitea:3000
GITEA_TOKEN=your_gitea_api_token_here
GITEA_USERNAME=your_gitea_username
# GITEA_ORGANIZATION=your_org_name  # Optional: create repos in an organization
